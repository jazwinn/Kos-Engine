<Project Sdk="Microsoft.NET.Sdk">
  <!-- The engine compiles these scripts at runtime with the bundled mono csc
       (ScriptHandler::m_CompileAllCSharptoSingleDLL). This project exists for IDE support. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>GameLogicScripts</RootNamespace>
    <AssemblyName>GameLogicScripts</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Engine\ScriptLibrary\GameScript\GameScript.csproj" />
  </ItemGroup>
</Project>
